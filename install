#!/usr/bin/env bash
set -euo pipefail
APP=deveco

MUTED='\033[0;2m'
GREEN='\033[0;32m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
NC='\033[0m' # No Color

# GitCode repository (override via env for testing)
GITCODE_OWNER=${GITCODE_OWNER:-openharmony-sig}
GITCODE_REPO=${GITCODE_REPO:-deveco-code}
GITCODE_API="https://gitcode.com/api/v5/repos/${GITCODE_OWNER}/${GITCODE_REPO}"

# ─── Friendly error helpers ──────────────────────────────────────────────────
die() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
    [ -n "${2:-}" ] && echo -e "${MUTED}  -> $2${NC}" >&2
    exit 1
}

warn() {
    echo -e "${ORANGE}[WARN]${NC} $1" >&2
    [ -n "${2:-}" ] && echo -e "${MUTED}  -> $2${NC}" >&2
}


# ─── Dependency checks ───────────────────────────────────────────────────────
if ! command -v curl >/dev/null 2>&1; then
    die "'curl' is required but not installed"
fi

# ─── Global cleanup trap ────────────────────────────────────────────────────
cleanup() {
    rm -rf "${TMPDIR:-/tmp}/deveco_install_$$"
    rm -rf "$VERSIONS_DIR"/.staging.*.$$ 2>/dev/null || true
    printf '\033[?25h' 2>/dev/null
}
trap cleanup EXIT

usage() {
    cat <<EOF
DevEco Code Installer

Usage: install [options]

Options:
    -h, --help              Display this help message
    -v, --version <version> Install a specific version (e.g., 0.1.4)
    -b, --binary <path>     Install from a local binary instead of downloading
        --no-modify-path    Don't modify shell config files (.zshrc, .bashrc, etc.)

Environment:
    GITCODE_OWNER           GitCode repo owner (default: openharmony-sig)
    GITCODE_REPO            GitCode repo name (default: deveco-code)
    VERSION                 Version to install (overridden by --version)

Examples:
    curl -fsSL https://raw.gitcode.com/openharmony-sig/deveco-code/raw/develop/install | bash
    curl -fsSL https://raw.gitcode.com/openharmony-sig/deveco-code/raw/develop/install | bash -s -- --version 0.1.4
    ./install --binary /path/to/deveco
EOF
}

requested_version=${VERSION:-}
no_modify_path=false
binary_path=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            if [[ -n "${2:-}" ]]; then
                requested_version="$2"
                shift 2
            else
                die "--version requires a version argument" "Usage: install --version 0.1.4"
            fi
            ;;
        -b|--binary)
            if [[ -n "${2:-}" ]]; then
                binary_path="$2"
                shift 2
            else
                die "--binary requires a file path" "Usage: install --binary /path/to/deveco"
            fi
            ;;
        --no-modify-path)
            no_modify_path=true
            shift
            ;;
        *)
            warn "Unknown option '$1', ignoring" "Run install --help to see available options"
            shift
            ;;
    esac
done

# ─── Versioned install directories ──────────────────────────────────────────
BIN_DIR="$HOME/.local/bin"
BIN_LINK="$BIN_DIR/$APP"
VERSIONS_DIR="$HOME/.local/share/deveco/versions"
VERSION_RETENTION_COUNT=2
mkdir -p "$VERSIONS_DIR" "$BIN_DIR"

# If --binary is provided, skip all download/detection logic
if [ -n "$binary_path" ]; then
    if [ ! -f "$binary_path" ]; then
        die "Binary not found: ${binary_path}" "Please check the path and try again"
    fi
    specific_version="local"
else
    raw_os=$(uname -s)
    case "$raw_os" in
      Darwin*) os="darwin" ;;
      MINGW*|MSYS*|CYGWIN*) os="windows" ;;
      *)
        die "Unsupported OS: $raw_os" "DevEco Code currently supports macOS and Windows (via Git Bash)"
        ;;
    esac

    arch=$(uname -m)
    if [[ "$arch" == "aarch64" ]]; then
      arch="arm64"
    fi
    if [[ "$arch" == "x86_64" ]]; then
      arch="x64"
    fi

    # macOS: detect Rosetta and use arm64 native binary
    if [ "$os" = "darwin" ] && [ "$arch" = "x64" ]; then
      rosetta_flag=$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)
      if [ "$rosetta_flag" = "1" ]; then
        arch="arm64"
      fi
    fi

    combo="$os-$arch"
    case "$combo" in
      darwin-x64|darwin-arm64|windows-x64)
        ;;
      *)
        die "Unsupported platform: $os/$arch" "Supported: macOS (Apple Silicon / Intel), Windows x64"
        ;;
    esac

    # Windows: detect AVX2 support for baseline fallback
    needs_baseline=false
    if [ "$os" = "windows" ] && [ "$arch" = "x64" ]; then
      ps="(Add-Type -MemberDefinition \"[DllImport(\"\"kernel32.dll\"\")] public static extern bool IsProcessorFeaturePresent(int ProcessorFeature);\" -Name Kernel32 -Namespace Win32 -PassThru)::IsProcessorFeaturePresent(40)"
      out=""
      if command -v powershell.exe >/dev/null 2>&1; then
        out=$(powershell.exe -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
      elif command -v pwsh >/dev/null 2>&1; then
        out=$(pwsh -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
      fi
      out=$(echo "$out" | tr -d '\r' | tr '[:upper:]' '[:lower:]' | tr '[:space:]')
      if [ "$out" != "true" ] && [ "$out" != "1" ]; then
        needs_baseline=true
      fi
    fi

    target="$os-$arch"
    if [ "$needs_baseline" = "true" ]; then
      target="$target-baseline"
    fi

    filename="$APP-$target.zip"

    if ! command -v unzip >/dev/null 2>&1; then
        die "'unzip' is required but not installed" "macOS: brew install unzip  |  Ubuntu: sudo apt install unzip"
    fi

    if [ -z "$requested_version" ]; then
        # Fetch latest stable release from GitCode releases API (mirrors GitHub /releases/latest).
        # Parse tag_name and prerelease with sed/grep (no jq dependency, matches upstream opencode).
        # Use here-string to avoid macOS `echo` stripping unescaped control chars in the body.
        release_json=$(curl -sS "${GITCODE_API}/releases/latest" 2>/dev/null) || {
            die "Failed to fetch version info from GitCode" "Check your network, or visit https://gitcode.com/${GITCODE_OWNER}/${GITCODE_REPO}/releases"
        }
        specific_version=$(sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' <<< "$release_json" | head -1 | sed 's/^v//')
        if grep -q '"prerelease"[[:space:]]*:[[:space:]]*true' <<< "$release_json"; then is_prerelease="true"; else is_prerelease="false"; fi

        if [[ -z "$specific_version" ]]; then
            die "No release found on GitCode" "Visit https://gitcode.com/${GITCODE_OWNER}/${GITCODE_REPO}/releases to check available versions"
        fi
        if [[ "$is_prerelease" == "true" ]]; then
            die "Latest GitCode release is marked as prerelease" "Visit https://gitcode.com/${GITCODE_OWNER}/${GITCODE_REPO}/releases to check available versions"
        fi
        echo -e "${ORANGE}Latest version: ${NC}$specific_version"
    else
        # Strip leading 'v' if present
        requested_version="${requested_version#v}"
        specific_version=$requested_version
        echo -e "${MUTED}Using specified version: ${NC}$specific_version"

        # Verify the release exists
        http_status=$(curl -sS -o /dev/null -w "%{http_code}" "${GITCODE_API}/releases/v${requested_version}" 2>/dev/null || echo "000")
        if [ "$http_status" != "200" ]; then
            die "Release v${requested_version} not found or unavailable (HTTP ${http_status})" "Available releases: https://gitcode.com/${GITCODE_OWNER}/${GITCODE_REPO}/releases"
        fi
    fi
    url="${GITCODE_API}/releases/v${specific_version}/attach_files/${filename}/download"
fi

check_version() {
    if [ -L "$BIN_LINK" ] && [ -x "$BIN_LINK" ]; then
        installed_version=$("$BIN_LINK" --version 2>/dev/null || echo "")

        if [[ "$installed_version" != "$specific_version" ]]; then
            echo -e "${MUTED}Installed version: ${NC}$installed_version."
        else
            echo -e "${MUTED}Version ${NC}$specific_version${MUTED} already installed, skipping"
            exit 0
        fi
    fi
}

unbuffered_sed() {
    if echo | sed -u -e "" >/dev/null 2>&1; then
        sed -nu "$@"
    elif echo | sed -l -e "" >/dev/null 2>&1; then
        sed -nl "$@"
    else
        local pad="$(printf "\n%512s" "")"
        sed -ne "s/$/\\${pad}/" "$@"
    fi
}

_last_pct_int=-1   # last rendered integer percent (used for 1%-granularity throttle)

# ─── Upgrade-style gradient progress bar ───
# Width 28, 6-stop gradient (pink→purple→blue→cyan→mint→green), ━ / ─ box-drawing chars.
# Falls back to 16-color when the terminal does not advertise truecolor.
BAR_WIDTH=28
GRADIENT_STOPS=("255 100 200" "200 100 255" "100 150 255" " 50 200 255" " 80 255 180" "100 255 100")

gradient_color() {
    local pos=$1
    local n=$((${#GRADIENT_STOPS[@]} - 1))
    local idx i t c1 c2 r g b
    idx=$(awk -v p="$pos" -v n="$n" 'BEGIN { v=p*n; if (v>n-0.001) v=n-0.001; print v }')
    i=${idx%.*}
    t=$(awk -v idx="$idx" -v i="$i" 'BEGIN { print idx-i }')
    c1=(${GRADIENT_STOPS[$i]})
    c2=(${GRADIENT_STOPS[$((i+1))]})
    r=$(awk -v t="$t" -v a="${c1[0]}" -v b="${c2[0]}" 'BEGIN { printf "%d", a+(b-a)*t+0.5 }')
    g=$(awk -v t="$t" -v a="${c1[1]}" -v b="${c2[1]}" 'BEGIN { printf "%d", a+(b-a)*t+0.5 }')
    b=$(awk -v t="$t" -v a="${c1[2]}" -v b="${c2[2]}" 'BEGIN { printf "%d", a+(b-a)*t+0.5 }')
    printf '\033[38;2;%d;%d;%dm' "$r" "$g" "$b"
}

supports_truecolor() {
    case "${COLORTERM:-}${TERM:-}" in
        *truecolor*|*24bit*) return 0 ;;
        *) return 1 ;;
    esac
}

render_upgrade_bar() {
    local pct=$1
    local filled
    filled=$(awk -v w="$BAR_WIDTH" -v p="$pct" 'BEGIN { f=int(w*p/100+0.5); if (f>w) f=w; print f }')
    local bar="" pos i
    local use_truecolor=false
    supports_truecolor && use_truecolor=true
    for ((i=0; i<filled; i++)); do
        if (( filled > 1 )); then
            pos=$(awk -v i="$i" -v w="$BAR_WIDTH" 'BEGIN { printf "%.4f", i/(w-1) }')
        else
            pos=0
        fi
        if $use_truecolor; then
            bar+="$(gradient_color "$pos")━"
        else
            # 16-color fallback: hand-tuned for AI palette (pink → purple → blue → cyan → green)
            local c
            case $(( i * 5 / BAR_WIDTH )) in
                0) c='\033[95m' ;;  # bright magenta (pink stop)
                1) c='\033[35m' ;;  # magenta (purple stop)
                2) c='\033[34m' ;;  # blue (blue stop)
                3) c='\033[36m' ;;  # cyan (cyan/mint stops)
                *) c='\033[32m' ;;  # green (green stop)
            esac
            bar+="${c}━"
        fi
    done
    bar+='\033[90m'
    local empties
    printf -v empties '%*s' $((BAR_WIDTH - filled)) ''
    bar+="${empties// /─}\033[0m"
    echo -ne "$bar"
}

print_progress() {
    local bytes="$1"
    local length="$2"
    [ "$length" -gt 0 ] || return 0

    local percent=$(( bytes * 100 / length ))
    [ "$percent" -gt 100 ] && percent=100

    # Throttle: render at most once per 1% increment, but always render 100%
    # (date +%s throttle was too coarse on fast downloads — skipped mid states)
    if (( percent < 100 )); then
        if (( percent == _last_pct_int )); then
            return
        fi
        _last_pct_int=$percent
    fi
    local bar
    bar=$(render_upgrade_bar "$percent")
    printf "\r%s %3d%%" "$bar" "$percent" >&4
}

download_with_progress() {
    local url="$1"
    local output="$2"

    if [ -t 2 ]; then
        exec 4>&2
    else
        exec 4>/dev/null
    fi

    local tmp_dir=${TMPDIR:-/tmp}
    local basename="${tmp_dir}/deveco_install_$$_fifo"
    local tracefile="${basename}.trace"

    rm -f "$tracefile"
    mkfifo "$tracefile"

    # Hide cursor
    printf "\033[?25l" >&4

    trap "trap - RETURN; rm -f \"$tracefile\"; printf '\033[?25h' >&4; exec 4>&-" RETURN

    (
        curl -f --trace-ascii "$tracefile" -s -L -o "$output" "$url"
    ) &
    local curl_pid=$!

    unbuffered_sed \
        -e 'y/ACDEGHLNORTV/acdeghlnortv/' \
        -e '/^0000: content-length:/p' \
        -e '/^<= recv data/p' \
        "$tracefile" | \
    {
        local length=0
        local bytes=0

        while IFS=" " read -r -a line; do
            [ "${#line[@]}" -lt 2 ] && continue
            local tag="${line[0]} ${line[1]}"

            if [ "$tag" = "0000: content-length:" ]; then
                length="${line[2]}"
                length=$(echo "$length" | tr -d '\r')
                bytes=0
            elif [ "$tag" = "<= recv" ]; then
                local size="${line[3]}"
                bytes=$(( bytes + size ))
                if [ "$length" -gt 0 ]; then
                    print_progress "$bytes" "$length"
                fi
            fi
        done

    }

    wait $curl_pid
    local ret=$?
    echo "" >&4
    return $ret
}

# ─── Versioned install helpers ────────────────────────────────────────────────
update_symlink() {
    local version_dir="$1"
    local tmp_link="$BIN_DIR/.$APP.$$"
    ln -sf "$version_dir/bin/$APP" "$tmp_link"
    mv -Tf "$tmp_link" "$BIN_LINK" 2>/dev/null ||
    mv -hf "$tmp_link" "$BIN_LINK" 2>/dev/null ||
    { rm -f "$BIN_LINK"; mv -f "$tmp_link" "$BIN_LINK"; }
}

cleanup_old_versions() {
    local current_target
    current_target=$(readlink "$BIN_LINK" 2>/dev/null | sed "s|/bin/$APP\$||")
    local versions=()
    while IFS= read -r dir; do
        versions+=("$dir")
    done < <(find "$VERSIONS_DIR" -mindepth 1 -maxdepth 1 -type d \
        -not -name '.*' 2>/dev/null | sort -V)

    local count=${#versions[@]}
    [ "$count" -le "$VERSION_RETENTION_COUNT" ] && return

    local to_delete=$((count - VERSION_RETENTION_COUNT))
    local deleted=0
    for dir in "${versions[@]}"; do
        [ "$deleted" -ge "$to_delete" ] && break
        # Protect the version the current symlink points to
        [ "$dir" = "$current_target" ] && continue
        rm -rf "$dir"
        deleted=$((deleted + 1))
    done
}

download_and_install() {
    echo -e "\n${MUTED}Installing ${NC}deveco ${MUTED}version: ${NC}$specific_version"
    local version_dir="$VERSIONS_DIR/$specific_version"
    local stage_dir="$VERSIONS_DIR/.staging.$specific_version.$$"
    local tmp_dir="${TMPDIR:-/tmp}/deveco_install_$$"

    # Skip download if this version is already fully installed
    if [ -x "$version_dir/bin/$APP" ]; then
        local existing_ver
        existing_ver=$("$version_dir/bin/$APP" --version 2>/dev/null || echo "")
        if [ "$existing_ver" = "$specific_version" ]; then
            echo -e "${MUTED}Version ${NC}$specific_version${MUTED} already installed, skipping download"
            update_symlink "$version_dir"
            cleanup_old_versions
            return
        fi
    fi

    mkdir -p "$stage_dir/bin" "$tmp_dir"

    if [[ "$os" == "windows" ]] || ! [ -t 2 ] || ! download_with_progress "$url" "$tmp_dir/$filename"; then
        curl -f -# -L -o "$tmp_dir/$filename" "$url"
    fi

    if [ ! -f "$tmp_dir/$filename" ] || [ ! -s "$tmp_dir/$filename" ]; then
        rm -rf "$tmp_dir" "$stage_dir"
        die "Download failed — file is empty or missing" "Check your network, or download manually from https://gitcode.com/${GITCODE_OWNER}/${GITCODE_REPO}/releases"
    fi

    if ! unzip -q "$tmp_dir/$filename" -d "$tmp_dir" 2>/dev/null; then
        rm -rf "$tmp_dir" "$stage_dir"
        die "Failed to extract archive — file may be corrupted" "Try running the install command again, or download the zip manually"
    fi

    # Find the binary - it may be at root or in bin/ subdirectory
    local binary_src="$tmp_dir/$APP"
    if [ ! -f "$binary_src" ]; then
        binary_src=$(find "$tmp_dir" -name "$APP" -type f -print -quit)
    fi
    if [ -z "$binary_src" ] || [ ! -f "$binary_src" ]; then
        rm -rf "$tmp_dir" "$stage_dir"
        die "Binary '$APP' not found in the archive" "The package may be corrupted — try downloading again"
    fi

    # Place binary into staging version directory
    mv "$binary_src" "$stage_dir/bin/$APP"
    chmod 755 "$stage_dir/bin/$APP"

    # Copy vendor directory into staging (ripgrep, mcp-bridge, etc.)
    local vendor_src
    vendor_src=$(find "$tmp_dir" -type d -name vendor -print -quit)
    if [ -n "$vendor_src" ]; then
        cp -r "$vendor_src" "$stage_dir/vendor"
    fi

    # Copy CHANGELOG.md into staging (needed by /release-notes)
    local changelog_src
    changelog_src=$(find "$tmp_dir" -maxdepth 2 -name "CHANGELOG.md" -not -path "*/bin/*" -not -path "*/vendor/*" -print -quit)
    if [ -n "$changelog_src" ]; then
        cp "$changelog_src" "$stage_dir/CHANGELOG.md"
    fi

    # Atomic switch: staging → version directory
    if [ -d "$version_dir" ]; then rm -rf "$version_dir"; fi
    mv "$stage_dir" "$version_dir"

    # Post-install smoke test
    if ! "$version_dir/bin/$APP" --version >/dev/null 2>&1; then
        rm -rf "$version_dir"
        rm -rf "$tmp_dir"
        die "Installation verification failed" "$version_dir/bin/$APP could not run — platform may be incompatible"
    fi

    # Update symlink and clean up old versions
    update_symlink "$version_dir"
    cleanup_old_versions
    rm -rf "$tmp_dir"
}

install_from_binary() {
    echo -e "\n${MUTED}Installing ${NC}deveco ${MUTED}from: ${NC}$binary_path"
    local version_dir="$VERSIONS_DIR/local"
    mkdir -p "$version_dir/bin"
    cp "$binary_path" "$version_dir/bin/$APP"
    chmod 755 "$version_dir/bin/$APP"
    update_symlink "$version_dir"
    cleanup_old_versions
}

if [ -n "$binary_path" ]; then
    install_from_binary
else
    check_version
    download_and_install
fi


add_to_path() {
    local config_file=$1
    local command=$2

    if grep -Fxq "$command" "$config_file"; then
        echo -e "${MUTED}PATH already configured in ${NC}$config_file${MUTED}, skipping${NC}"
    elif [[ -w $config_file ]]; then
        echo -e "\n# deveco" >> "$config_file"
        echo "$command" >> "$config_file"
        echo -e "${GREEN}Added $BIN_DIR to user PATH ($config_file)${NC}"
        _path_modified=true
    else
        warn "Cannot write to $config_file — please add PATH manually"
        echo -e "  $command"
    fi
}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

current_shell=$(basename "$SHELL")
case $current_shell in
    fish)
        config_files="$HOME/.config/fish/config.fish"
    ;;
    zsh)
        config_files="${ZDOTDIR:-$HOME}/.zshrc ${ZDOTDIR:-$HOME}/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv"
    ;;
    bash)
        config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
    ash)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    sh)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    *)
        # Default case if none of the above matches
        config_files="$HOME/.bashrc $HOME/.bash_profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
esac

_path_modified=false

if [[ "$no_modify_path" != "true" ]]; then
    config_file=""
    for file in $config_files; do
        if [[ -f $file ]]; then
            config_file=$file
            break
        fi
    done

    if [[ -z $config_file ]]; then
        warn "No shell config file found for $current_shell" "Please add the following to your shell config manually:"
        echo -e "  export PATH=$BIN_DIR:\$PATH"
    elif [[ ":$PATH:" != *":$BIN_DIR:"* ]]; then
        case $current_shell in
            fish)
                add_to_path "$config_file" "fish_add_path $BIN_DIR"
            ;;
            zsh)
                add_to_path "$config_file" "export PATH=$BIN_DIR:\$PATH"
            ;;
            bash)
                add_to_path "$config_file" "export PATH=$BIN_DIR:\$PATH"
            ;;
            ash)
                add_to_path "$config_file" "export PATH=$BIN_DIR:\$PATH"
            ;;
            sh)
                add_to_path "$config_file" "export PATH=$BIN_DIR:\$PATH"
            ;;
            *)
                export PATH=$BIN_DIR:$PATH
                warn "Unrecognized shell — please add PATH manually"
                echo -e "  export PATH=$BIN_DIR:\$PATH"
            ;;
        esac
    fi
else
    echo -e "${MUTED}Skipping PATH modification (--no-modify-path)${NC}"
fi

echo -e ""
echo -e "${NC}▃▃▃▃  ▃▃▃▃ ▃   ▃ ▃▃▃▃  ▃▃▃   ▃▃▃     ▃▃▃   ▃▃▃  ▃▃▃▃  ▃▃▃▃${NC}"
echo -e "${NC}▃   ▃ ▃    ▃   ▃ ▃    ▃   ▃ ▃   ▃   ▃   ▃ ▃   ▃ ▃   ▃ ▃   ${NC}"
echo -e "${NC}▄   ▄ ▄▄▄▄ ▄   ▄ ▄▄▄▄ ▄     ▄   ▄   ▄     ▄   ▄ ▄   ▄ ▄▄▄▄${NC}"
echo -e "${NC}▅   ▅ ▅    ▅   ▅ ▅    ▅   ▅ ▅   ▅   ▅   ▅ ▅   ▅ ▅   ▅ ▅   ${NC}"
echo -e "${NC}▆▆▆▆  ▆▆▆▆  ▆▆▆  ▆▆▆▆  ▆▆▆   ▆▆▆     ▆▆▆   ▆▆▆  ▆▆▆▆  ▆▆▆▆${NC}"
echo -e ""
if [ "$specific_version" = "local" ]; then
    echo -e "${MUTED}Local binary installed.${NC}"
else
    echo -e "${MUTED}v$specific_version installed.${NC}"
fi

# PATH hint — only when PATH was actually modified
if [ "$_path_modified" = true ]; then
    echo -e "${ORANGE}Note: Open a new terminal for PATH changes to take effect.${NC}"
    echo -e ""
    echo -e "${MUTED}To activate PATH in this shell, run:${NC}"
    echo -e "  ${GREEN}source $config_file${NC}"
    echo -e ""
fi

echo -e ""
echo -e "${MUTED}Get started:${NC}"
echo -e ""
echo -e "cd <project>  ${MUTED}# Open your project directory${NC}"
echo -e "deveco        ${MUTED}# Launch DevEco Code${NC}"
echo -e ""
