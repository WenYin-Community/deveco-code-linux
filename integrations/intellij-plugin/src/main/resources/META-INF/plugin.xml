<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
  <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
  <id>org.deveco.code.deveco-code-jetbrains-plugin</id>

  <!-- Public plugin name should be written in Title Case.
   Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
  <name>DevEco Code</name>

  <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
       Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
  <description><![CDATA[
    <p>一站式HarmonyOS应用AI开发工具，覆盖代码生成、问题修复、编译构建、功能验证等开发旅程，通过自然语言快速开发HarmonyOS应用。</p>

    <p>All-in-one AI development tool for HarmonyOS apps, covering the entire development
       journey including code generation, issue fixing, build and compilation, and
       functional verification. This enables rapid development of HarmonyOS apps using
       natural language.</p>
  ]]></description>

  <!-- Product and plugin compatibility requirements.
       Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.compose</depends>
  <depends>com.intellij.mcpServer</depends>
  <!-- Hard dependency: DevEco Code is disabled together with CodeGenie. -->
  <depends>com.huawei.deveco.intelligent-assistant</depends>
  <dependencies>
    <module name="intellij.platform.jewel.markdown.core" />
    <module name="intellij.platform.jewel.markdown.extensions.gfmTables" />
    <module name="intellij.platform.jewel.markdown.ideLafBridgeStyling" />
  </dependencies>

  <resource-bundle>messages.MyMessageBundle</resource-bundle>

  <!-- Extensions defined by the plugin.
       Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-point.html -->
  <extensions defaultExtensionNs="com.intellij">
    <!-- Services are declared as heavy services instead of @Service light
         services: on dynamic plugin disable/re-enable the container reliably
         unregisters descriptor-registered services, while stale light-service
         instances can survive and surface as ClassCastException on the next
         lookup (cross-classloader cast). -->
    <applicationService serviceImplementation="org.deveco.code.acp.SharedAcpBackend" />
    <applicationService serviceImplementation="org.deveco.code.skill.GlobalSkillStateService" />
    <projectService serviceImplementation="org.deveco.code.acp.AcpClientService" />
    <projectService serviceImplementation="org.deveco.code.session.SessionControllerRegistry" />
    <projectService serviceImplementation="org.deveco.code.session.editor.SessionEditorRegistry" />
    <projectService serviceImplementation="org.deveco.code.action.DevEcoSessionActions" />
    <projectService serviceImplementation="org.deveco.code.session.SessionModelStore" />
    <projectService serviceImplementation="org.deveco.code.session.SessionViewStateStore" />
    <projectService serviceImplementation="org.deveco.code.session.TokenUsageStore" />
    <fileEditorProvider implementation="org.deveco.code.session.editor.SessionFileEditorProvider" />
    <fileIconProvider implementation="org.deveco.code.session.editor.SessionFileIconProvider" />
    <notificationGroup id="DevEco Code Migration" displayType="BALLOON" />
    <postStartupActivity implementation="org.deveco.code.action.NewSessionToolbarRegistrar" />
    <!-- Backstop only; the preload itself normally starts at app creation. -->
    <postStartupActivity implementation="org.deveco.code.toolwindow.ToolWindowPreloadRegistrar" />
  </extensions>

  <applicationListeners>
    <!-- Restores/drops the runtime-added main toolbar button across dynamic
         disable/re-enable cycles of this plugin. -->
    <listener class="org.deveco.code.action.NewSessionToolbarLifecycle"
      topic="com.intellij.ide.plugins.DynamicPluginListener" />
    <!-- Defines the tool window UI classes off the EDT before the first, login-triggered
         Compose tab creation; see ToolWindowPreloader for why this must stay race-free. -->
    <listener class="org.deveco.code.toolwindow.ToolWindowPreloadLifecycle"
      topic="com.intellij.ide.AppLifecycleListener" />
    <listener class="org.deveco.code.toolwindow.ToolWindowPreloadLifecycle"
      topic="com.intellij.ide.plugins.DynamicPluginListener" />
  </applicationListeners>

  <actions>
    <action id="org.deveco.code.action.NewSessionAction" class="org.deveco.code.action.NewSessionAction"
      text="New Session" description="Create a new DevEco Code session">
    </action>
    <action id="org.deveco.code.action.NewSessionToolbarAction"
      class="org.deveco.code.action.NewSessionToolbarAction" text="New Session"
      description="Create a new DevEco Code session" icon="AllIcons.General.Add" />
    <group id="org.deveco.code.action.JumpToChatAction" class="org.deveco.code.action.JumpToChatAction"
      text="DevEco Code" popup="true">
      <action id="org.deveco.code.action.QuickChatAction" class="org.deveco.code.action.QuickChatAction"
        description="Send selected code to a new DevEco Code chat session" />
      <add-to-group group-id="EditorPopupMenu" anchor="first" />
    </group>
  </actions>

</idea-plugin>
